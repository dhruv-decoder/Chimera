# Backend environment. Copy to backend/.env and add your key. All values are
# optional - the system runs fully offline (deterministic planner) without them.

# Live LLM ideation via Groq (free tier, open-source models). Leave blank to
# use the offline planner.
GROQ_API_KEY=

# Overrides (defaults shown). Groq's Llama 3.x endpoints were retired on
# 17 Jun 2026; these open-weight models are the current free-tier replacements.
CHIMERA_GROQ_MODEL=openai/gpt-oss-120b
CHIMERA_GROQ_MODEL_FAST=openai/gpt-oss-20b
CHIMERA_SEED=42
