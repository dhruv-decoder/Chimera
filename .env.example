# Copy to backend/.env to enable the live LLM ideation agent (optional).
# Without a key, the ideation agent runs a deterministic offline planner, so the
# system, loop and demo all work with zero external dependencies.

# Groq (free tier, open-weight models) - primary. Get a key at https://console.groq.com
# (Groq retired the Llama 3.x endpoints on 17 Jun 2026; these are the current free-tier models.)
GROQ_API_KEY=
CHIMERA_GROQ_MODEL=openai/gpt-oss-120b
CHIMERA_GROQ_MODEL_FAST=openai/gpt-oss-20b

# Global reproducibility seed.
CHIMERA_SEED=42

# Frontend -> backend origin (only needed if not using the dev proxy).
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
